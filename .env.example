# --- GCP / Vertex AI (Gemini) ---
GCP_PROJECT_ID=niaga-496405
GCP_LOCATION=us-central1
GOOGLE_APPLICATION_CREDENTIALS=./credentials/niaga-backend-key.json

# Per-agent model selection (Vertex AI Gemini models)
MODEL_PROSPECTOR=gemini-2.5-flash
MODEL_BULL=gemini-2.5-flash
MODEL_BEAR=gemini-2.5-flash
MODEL_JUDGE=gemini-2.5-pro
MODEL_OUTREACH=gemini-2.5-pro
MODEL_REPLY=gemini-2.5-flash
MODEL_CLOSER=gemini-2.5-pro
MODEL_AFTERCARE=gemini-2.5-flash

# --- Cost safety ---
MAX_LEADS_PER_RUN=3
AGENT_CALL_TIMEOUT_SECONDS=90
RUN_COST_CAP_USD=5.00

# --- Email (Gmail SMTP + IMAP) ---
GMAIL_ADDRESS=tim.niaga@gmail.com
GMAIL_APP_PASSWORD=                       # 16-char app password from Google Account
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
IMAP_HOST=imap.gmail.com
IMAP_PORT=993
IMAP_POLL_INTERVAL_SECONDS=15

# --- DOKU payment (mock by default; real adapter when credentials arrive) ---
PAYMENT_PROVIDER=mock                     # mock | doku
DOKU_CLIENT_ID=
DOKU_SECRET_KEY=
DOKU_WEBHOOK_SECRET=
DOKU_BASE_URL=https://api-sandbox.doku.com

# --- Web search (for Prospector agent) ---
SERPER_API_KEY=                           # serper.dev free tier (2,500 searches)

# --- Backend ---
DATABASE_URL=sqlite:///./backend/niaga.db
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
LOG_LEVEL=INFO

# --- Frontend ---
VITE_API_BASE_URL=http://localhost:8000
VITE_WS_BASE_URL=ws://localhost:8000

# --- Deployment ---
PUBLIC_BASE_URL=                          # e.g. https://niaga.your-sumopod-vps.com
